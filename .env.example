# Porta HTTP da API.
PORT=3000
# Origens liberadas no CORS (o Expo web roda em http://localhost:8081). Use * para liberar todas.
CORS_ORIGIN=*
# URL de conexão do PostgreSQL (obrigatória).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farmacia_perto
# Banco usado só pelos testes de integração. Esses testes apagam os dados deste banco.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/farmacia_perto_test
