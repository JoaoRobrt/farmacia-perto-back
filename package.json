{
  "name": "farmacia-perto-back",
  "version": "1.0.0",
  "private": true,
  "description": "API do Farmácia Perto: estados, municípios e farmácias credenciadas ao Programa Farmácia Popular.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrar.ts",
    "db:importar": "tsx src/db/importar.cli.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  }
}
